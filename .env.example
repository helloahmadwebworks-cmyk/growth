# ==============================================================================
# GrowByMasters Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development or set these variables
# in your deployment platform (Vercel, Netlify, Docker, AWS Amplify).
#
# CRITICAL SECURITY RULE:
# Never commit real API keys or secrets to public or shared version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TRANSACTIONAL EMAIL (Resend)
# Used for internal agency instant lead alerts & branded prospect audit receipts.
# Obtain key at: https://resend.com/api-keys
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_production_resend_api_key_here
NOTIFICATION_EMAIL=contact@growbymasters.com

# ------------------------------------------------------------------------------
# 2. CRM & WEBHOOK DISPATCH (HubSpot / Webhook)
# Option A: HubSpot CRM Integration
# Create a Private App in HubSpot Settings -> Integrations -> Private Apps with:
# Scopes: crm.objects.contacts.write, crm.objects.contacts.read
# ------------------------------------------------------------------------------
HUBSPOT_ACCESS_TOKEN=pat-na1-your_hubspot_private_app_token_here

# Option B: Universal Webhook (Zapier, Make, Slack, n8n, Supabase, Custom CRM)
# If provided, all scored and enriched leads are POSTed in real time.
LEAD_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/your_webhook_id/

# ------------------------------------------------------------------------------
# 3. ADMINISTRATIVE PIPELINE ACCESS
# Bearer token required to inspect (/api/admin/leads) and advance pipeline
# stages (PATCH /api/admin/leads). Keep this strong and confidential.
# ------------------------------------------------------------------------------
ADMIN_API_KEY=gbm_sec_super_secret_admin_token_2026

# ------------------------------------------------------------------------------
# 4. WEB ANALYTICS & SEARCH CONSOLE ATTRIBUTION
# GA4: Google Analytics 4 Measurement ID (G-XXXXXXXXXX)
# GTM: Google Tag Manager Container ID (GTM-XXXXXXX)
# GSC: Search Console verification meta tag content string
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_search_console_verification_token

# ------------------------------------------------------------------------------
# 5. STRATEGY CALL BOOKING PROVIDER (Cal.com / Calendly)
# Embed URL for direct appointment scheduling on /book-call.
# Leave blank to use the built-in direct appointment time-window selector.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CAL_EMBED_URL=https://cal.com/growbymasters/strategy-call
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/growbymasters/strategy-call

# ------------------------------------------------------------------------------
# 6. SITE & CANONICAL DOMAIN
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://growbymasters.com
